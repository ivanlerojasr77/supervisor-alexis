# Endpoint del proyecto de Microsoft Foundry, no el endpoint del recurso.
AZURE_AI_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>

# Usa los nombres exactos que aparecen en Foundry.
SUPERVISOR_AGENT_NAME=supervisor-alexis
FINANCIAL_AGENT_NAME=analista-financiero
TECHNICAL_AGENT_NAME=analista-tecnico
